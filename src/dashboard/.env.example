# The hosted demo's analytics ids. The build writes them into dist/site-analytics.json,
# which the server reads in hosted_demo mode for the consent bar (src/server/site-analytics.ts).
# Vite reads these two from the shell's environment, not from this file.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_PROJECT_ID=your-clarity-id
