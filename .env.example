# Paracosm Simulation Engine
# Copy to .env and fill in your keys
# All search keys are also configurable from the dashboard Settings panel

# === LLM Providers (at least one required) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === Research & Web Search (all optional, more = better) ===
# These power the research pipeline: department agents use live web search
# to find real citations (NASA papers, medical journals, domain research)
# during crisis analysis. With all 4 providers, search coverage is maximized
# and Cohere neural reranking produces the most relevant results.
#
# Also used by the Scenario Compiler for real-world seed ingestion:
# upload a document and the compiler enriches the scenario knowledge
# bundle with live web research grounded in your seed material.
#
# Get free API keys:
#   Serper:    https://serper.dev (2,500 free searches)
#   Tavily:    https://tavily.com (1,000 free searches/mo)
#   Firecrawl: https://firecrawl.dev (500 free credits)
#   Cohere:    https://cohere.com (rate-limited free tier)

# Google search via Serper (most general web coverage)
SERPER_API_KEY=

# AI-optimized search with structured content extraction
TAVILY_API_KEY=

# Web scraping + search with clean markdown extraction
FIRECRAWL_API_KEY=

# Neural reranking via Cohere rerank-v3.5
# Reorders search results by semantic relevance to the query
# Dramatically improves citation quality when combined with any search provider
COHERE_API_KEY=

# === Scenario Compiler ===
# The compiler generates runtime hooks from scenario JSON via LLM calls
# Uses ANTHROPIC_API_KEY or OPENAI_API_KEY (whichever is set)
# Cost: ~$0.10 per scenario compile, cached after first generation

# === Server ===
PORT=3456
# The address `paracosm dashboard` listens on. Unset: 127.0.0.1 on a local
# server, so no other machine reaches it; every interface on the hosted demo
# and in platform API mode. HOST=0.0.0.0 serves a container or a LAN demo.
# HOST=

# === Rate Limiting ===
# Simulation runs per IP address per day on this server's own keys; a
# request that brings its own provider key is not counted. Unset, the
# limit is 1. 0 turns it off for local dev, and with it the daily compile
# limit and the hourly chat limits. A value that is not a whole number
# keeps the limit at 1 and logs a warning.
#
# With PARACOSM_HOSTED_DEMO=true the Quickstart routes bill the host's keys
# and count against the same caller: a compile-from-seed against the daily
# compile limit (5, shared with /compile, with at most 4 compiles pending
# server-wide), the grounding, actor and URL routes against a daily limit of
# 20, and a Digital Twin run against the daily run limit. A /compile there
# runs at most 5 web searches; one that brings its own model key uses the
# host's search keys on the compile limit, and past it compiles without web
# search.
RATE_LIMIT=3

# The header the proxy in front of this server sets to the client's
# address, which the limits above key on. Unset, they key on the
# connection's address and ignore every address header, since any caller
# can send one. Set it only when every request reaches the server through
# that proxy: cf-connecting-ip behind Cloudflare, x-real-ip or
# x-forwarded-for (its last entry) behind a proxy that sets them. A value
# that is not an IP address is ignored. An IPv6 address counts as its /64
# network, and an IPv4-mapped IPv6 address as the IPv4 address it carries.
# PARACOSM_CLIENT_IP_HEADER=cf-connecting-ip
#
# Open event streams (/events and /sessions/:id/replay) one client address
# may hold, and all addresses together; a stream past either answers 429.
# PARACOSM_MAX_STREAMS_PER_ADDRESS=32
# PARACOSM_MAX_STREAMS=2000
#
# New runs one client address may import a day (UTC) through
# POST /api/v1/library/import; a run id already stored is not counted.
# PARACOSM_IMPORTS_PER_DAY=500
#
# Runs on a caller's own provider key are not counted by the daily run
# limit, so one client address holds at most PARACOSM_MAX_RUNS minus one
# run slots with them (at least one).

# === Admin endpoints (POST /admin/sessions/save, POST /admin/data/wipe,
# DELETE /admin/scenarios/:id, and POST /scenario/store with saveToDisk) ===
# ADMIN_WRITE is the master switch — off (or unset) means these return 403
# regardless of headers. ADMIN_TOKEN is the per-request bearer token; clients
# send it via the `X-Admin-Token` header, compared in constant time. When
# ADMIN_WRITE=true and ADMIN_TOKEN is unset, the routes return 503
# (fail-closed) instead of being open. A /scenario/store without saveToDisk
# (the in-memory store) needs neither. With ADMIN_WRITE=true the dashboard's
# Settings tab shows an Admin Token field: enter ADMIN_TOKEN there and press
# Save. The dashboard keeps it in that browser's localStorage under
# `paracosm:adminToken` and sends it on Wipe All, the scenario delete and
# Save to Disk. Generate a 32-char random secret:
#   openssl rand -hex 16
ADMIN_WRITE=false
ADMIN_TOKEN=
